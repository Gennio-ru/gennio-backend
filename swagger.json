  "info": {
    "title": "AI Platform API",
    "description": "Prompts / Generations / Users",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "UserRole": {
        "type": "string",
        "enum": [
          "user",
          "admin"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "email": {
            "type": "string",
            "example": "user@example.com",
            "nullable": true
          },
          "yandexId": {
            "type": "string",
            "nullable": true
          },
          "phone": {
            "type": "string",
            "example": "+79998887766",
            "nullable": true
          },
          "role": {
            "example": "user",
            "$ref": "#/components/schemas/UserRole"
          },
          "credits": {
            "type": "number",
            "example": 100,
            "description": "Баланс кредитов"
          },
          "isActive": {
            "type": "boolean",
            "example": true,
            "description": "Активен ли пользователь"
          },
          "isEmailVerified": {
            "type": "boolean",
            "example": false
          },
          "isPhoneVerified": {
            "type": "boolean",
            "example": true
          },
          "lastLoginAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "id",
          "createdAt",
          "updatedAt",
          "role",
          "credits",
          "isActive",
          "isEmailVerified",
          "isPhoneVerified"
        ]
      },
      "RegisterByEmailDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
