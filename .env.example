# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=ai_platform

# JWT
JWT_ACCESS_SECRET=supersecret_access
JWT_REFRESH_SECRET=supersecret_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CORS / Cookies
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# App
PORT=3000

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
NODE_ENV=development

#REDIS
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_BULL_URL=redis://127.0.0.1:6379/1

YANDEX_S3_REGION=ru-central1
YANDEX_S3_ENDPOINT=https://storage.yandexcloud.net
YANDEX_S3_BUCKET=gennie-bucket
YANDEX_S3_KEY=******
YANDEX_S3_SECRET=******

# SMTP
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465          # 465 (SSL) или 587 (STARTTLS)
SMTP_SECURE=true       # true для 465, false для 587
SMTP_USER=no-reply@gennio.ru
SMTP_PASS=**********

# От кого по умолчанию
MAIL_FROM=Gennio<no-reply@gennio.ru>
