<!doctype html>
<html lang="ru">
  <body style="margin:0;padding:24px;font-family:Arial,Helvetica,sans-serif;background:#f8f9fb;">
    <div style="max-width:560px;margin:0 auto;background:#ffffff;border-radius:12px;padding:24px;">
      <h2 style="margin:0 0 12px 0;">Код подтверждения для {{project}}</h2>
      <p style="margin:0 0 16px 0;color:#444;">Используйте этот код для подтверждения. Никому его не сообщайте.</p>
      <div style="font-size:32px;letter-spacing:4px;font-weight:700;margin:16px 0 24px 0;">{{code}}</div>
      <p style="margin:0 0 16px 0;color:#444;">Код действует <b>{{expireMinutes}} минут</b>.</p>
      <hr style="border:none;border-top:1px solid #eee;margin:24px 0;" />
      <p style="font-size:12px;color:#777;margin:0;">Письмо отправлено автоматически. Поддержка: {{supportEmail}}</p>
    </div>
  </body>
</html>